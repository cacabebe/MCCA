    "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "ADB 默认方式",
            "type": "Adb"
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "{PROJECT_DIR}/resource/base"
            ]
        },
        {
            "name": "B 服",
            "path": [
                "{PROJECT_DIR}/resource/base",
                "{PROJECT_DIR}/resource/bilibili"
            ]
        }
    ],
    "task": [
        {
            "name": "刷主线",
            "entry": "刷主线_入口",
            "check": false,
            "option": [
                "刷主线关卡选择"
            ],
            "doc": "自动扫荡普通7-8（传说之外）。可从首页、出击页或第7章普通地图开始，自动寻找米德加尔特；未找到时最多向左上拖动3次。需已解锁扫荡，按现有燃料自动调整每批1–10次，持续到燃料不足，不购买或使用燃料道具。请勿与推主线同时勾选。"
        },
        {
            "name": "推主线",
            "entry": "主线_入口",
            "check": false,
            "doc": "先打开普通或困难主线当前进度页，开启自动战斗并配好队伍。保持当前难度，优先选新关卡、跳过剧情、原队开战并继续下一关。通关后不重播或重打，30秒内未找到下一关则停止。燃料不足或战败停止，不补充燃料；未知界面/单场战斗超过10分钟超时停止。可在剧情或战斗中接续。"
        },
        {
            "name": "启动游戏",
            "entry": "进入首页",
            "check": true,
            "doc": "无"
        },
        {
            "name": "刷当期活动",
            "entry": "当期活动_入口",
            "check": false,
            "doc": "香川大典。从首页进入，领取密事录红色感叹号奖励，在山间供奉用现有燃料尽量购买入场券，再扫荡困难首关「初遇，香川庄园」。优先用完可用的双倍掉落次数，之后继续扫荡至入场券不足。需已解锁该关扫荡。"
        },
        {
            "name": "活动",
            "entry": "活动_入口",
            "check": true,
            "doc": "[color:red]活动功能暂时只有困难最后一关，且版本更新后未必能继续使用[/color]"
        },
        {
            "name": "每日免费礼包",
            "entry": "Shopping",
            "check": true,
            "doc": "无"
        },
        {
            "name": "限时贸易所购买",
            "entry": "Time-limited Shopping",
            "check": true,
            "doc": "无"
        },
        {
            "name": "每周商店购买",
            "entry": "周购_入口",
            "check": false,
            "doc": "按清单购买异星灰域、罕见星尘区和模拟军演商店的指定商品。微晶仅买罕见星尘区的限量档，军演传说星尘不限属性。使用各区兑换币购买可负担的最大数量，售罄自动跳过。"
        },
        {
            "name": "模拟军演",
            "entry": "模拟军演",
            "check": true,
            "doc": "无",
            "option": [
                "刷新战力阈值"
            ],
            "pipeline_override": {
                "首页_出击": {
                    "next": "模拟军演_入口"
                }
            }
        },
        {
            "name": "基建",
            "entry": "Infrastructures",
            "doc": "可能会有bug",
            "option": [
                "是否访问每个好友换抽"
            ]
        },
        {
            "name": "每日探索",
            "entry": "出击任务列表",
            "option": [
                "关卡选择",
                "第几层",
                "是否手动选择次数(开启燃料使用)",
                "手动次数"
            ]
        },
        {
            "name": "周本",
            "entry": "WeekInstance",
